{
  "title": "Agency OS — Engineering",
  "uid": "agencyos-eng",
  "schemaVersion": 39,
  "refresh": "30s",
  "panels": [
    {
      "type": "timeseries", "title": "5xx by route", "gridPos": { "x": 0, "y": 0, "w": 12, "h": 6 },
      "targets": [{ "expr": "sum(rate(agencyos_http_requests_total{status=~\"5..\"}[5m])) by (route)" }]
    },
    {
      "type": "timeseries", "title": "p95 latency (s)", "gridPos": { "x": 12, "y": 0, "w": 12, "h": 6 },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(agencyos_http_request_duration_seconds_bucket[10m])) by (le))"
      }]
    },
    {
      "type": "timeseries", "title": "Queue depth by status", "gridPos": { "x": 0, "y": 6, "w": 8, "h": 6 },
      "targets": [{ "expr": "agencyos_queue_jobs" }]
    },
    {
      "type": "stat", "title": "Database up", "gridPos": { "x": 8, "y": 6, "w": 4, "h": 6 },
      "targets": [{ "expr": "agencyos_database_up" }]
    },
    {
      "type": "timeseries", "title": "Executions by status", "gridPos": { "x": 12, "y": 6, "w": 12, "h": 6 },
      "targets": [{ "expr": "agencyos_executions" }]
    }
  ]
}
