# Enterprise AI Agency OS — environment template
# Copy to .env and fill in. NEVER commit real values.

# ---- core ----
NODE_ENV=local
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# SQLite file for local dev; use postgres://… for production (ADR-0004)
DATABASE_URL=./data/agencyos.sqlite

# Comma-separated browser origins allowed by CORS (no wildcard in production)
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# Admin API key. If unset, the server generates a one-time key at boot.
# Production REQUIRES this to be set explicitly.
ADMIN_BOOTSTRAP_KEY=

# ---- rate limiting ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600

# ---- sandboxing ----
# process = local development only; docker = required default for production
SANDBOX_PROVIDER=process

# ---- model providers (optional) ----
# Any OpenAI-compatible endpoint: Ox Alpha gateway, OpenAI, vLLM, Ollama /v1…
MODEL_PROVIDER_API_KEY=
MODEL_PROVIDER_BASE_URL=
MODEL_PROVIDER_MODEL=ox-alpha
MODEL_PROVIDER_CONTEXT=200000
MODEL_PROVIDER_COST_IN_PER_1K=0.002
MODEL_PROVIDER_COST_OUT_PER_1K=0.008
MODEL_DEFAULT_TIER=STANDARD

# ---- budgets ----
DEFAULT_DAILY_BUDGET_USD=25

# ---- integrations (optional) ----
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com
WEBHOOK_OUTBOUND_URL=
WEBHOOK_OUTBOUND_SECRET=

# ---- feature flags (optional subsystems) ----
FEATURE_BROWSER_AUTOMATION=false
FEATURE_AGENTIC_SOC=true
FEATURE_A2A=false
FEATURE_HERMES=false
FEATURE_VECTOR_KNOWLEDGE=false

# ---- docker compose only ----
POSTGRES_PASSWORD=
GRAFANA_PASSWORD=
