# Control plane — Node 24 runs TypeScript natively (ADR-0003)
FROM node:24-bookworm-slim AS runtime

WORKDIR /app
ENV NODE_ENV=production

# 1) Manifests first so dependency install is a cached layer.
#    Workspace package.json files must exist for npm ci to link workspaces.
COPY package.json package-lock.json ./
COPY packages/core/package.json packages/core/
COPY packages/db/package.json packages/db/
COPY packages/security/package.json packages/security/
COPY packages/models/package.json packages/models/
COPY packages/orchestration/package.json packages/orchestration/
COPY packages/integrations/package.json packages/integrations/
COPY packages/delivery/package.json packages/delivery/
COPY apps/control-plane/package.json apps/control-plane/

# 2) Install production dependencies only (lockfile-pinned, reproducible)
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

# 3b) git is REQUIRED by the autonomous delivery loop (worktree isolation,
#     commit, ff-only merge). Slim images omit it. Version tracks the pinned
#     bookworm base (digest-pinned via registry); --no-install-recommends keeps
#     the layer minimal, lists cleaned for image hygiene.
RUN apt-get update \
  && apt-get install -y --no-install-recommends git \
  && rm -rf /var/lib/apt/lists/* \
  && git --version

# 3) Sources
COPY packages ./packages
COPY apps/control-plane ./apps/control-plane
COPY scripts ./scripts

# Non-root user, no shell needed
RUN groupadd -r agency && useradd -r -g agency agency \
  && mkdir -p /app/data && chown -R agency:agency /app
USER agency

EXPOSE 3000
VOLUME ["/app/data"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
  CMD node -e "fetch('http://127.0.0.1:3000/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["node", "apps/control-plane/src/server.ts"]
